# =============================================================================
# TrustGraph 2026 — Environment Configuration Template
# =============================================================================
# Copy this file to .env (NEVER commit .env to version control).
#
# ZERO PII POLICY: This config never touches customer data fields.
# All secrets are loaded at runtime via python-dotenv / Node process.env.
# =============================================================================

# ─── Blockchain / Web3 ────────────────────────────────────────────────────────

# JSON-RPC endpoint for your target network.
# Polygon Amoy Testnet (Chain ID: 80002):
#   https://rpc-amoy.polygon.technology
# OR use Alchemy/Infura for production-grade reliability:
#   https://polygon-amoy.g.alchemy.com/v2/<YOUR_ALCHEMY_KEY>
RPC_URL=https://rpc-amoy.polygon.technology

# Ethereum Sepolia fallback (Chain ID: 11155111):
# RPC_URL=https://rpc.sepolia.org

# The chain ID corresponding to RPC_URL above.
# Polygon Amoy = 80002  |  Ethereum Sepolia = 11155111
CHAIN_ID=80002

# EVM wallet private key used to sign anchorProof() transactions.
# NEVER expose this — use a dedicated service wallet with minimal MATIC balance.
# Fund on Amoy faucet: https://faucet.polygon.technology
WALLET_PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# Deployed TrustGraphAudit.sol contract address (post-deployment).
# Run: npx hardhat run scripts/deploy_audit.js --network polygonAmoy
# Paste the deployed address here (checksum format).
CONTRACT_ADDRESS=0xYOUR_CONTRACT_ADDRESS_HERE

# Block explorer base URL for transaction links (shown in demo output).
# Polygon Amoy:
POLYGONSCAN_BASE=https://amoy.polygonscan.com/tx
# Ethereum Sepolia:
# POLYGONSCAN_BASE=https://sepolia.etherscan.io/tx

# ─── AI / Gemini ──────────────────────────────────────────────────────────────

# Google Gemini API key — used by the AI explanation engine (Module 3/4).
# Obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# ─── Backend API ──────────────────────────────────────────────────────────────

# FastAPI server host/port (Module 3 backend).
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# ─── Database ─────────────────────────────────────────────────────────────────

# PostgreSQL connection URI (Module 3 — fraud case database).
DATABASE_URL=postgresql://trustgraph:CHANGEME@localhost:5432/trustgraph_db

# ─── Application ──────────────────────────────────────────────────────────────

# Set to "production" when deploying to production.
ENVIRONMENT=development

# Cross-Origin origins allowed by the FastAPI backend.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
