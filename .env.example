# =============================================================================
# TrustGraph 2026 — Environment Configuration Template
# =============================================================================
# Copy this file to .env (NEVER commit .env to version control).
#   cp .env.example .env
#
# ZERO PII POLICY: This config never touches customer data fields.
# All secrets are loaded at runtime via python-dotenv / Vite import.meta.env.
# =============================================================================

# ─── Django Core ──────────────────────────────────────────────────────────────

# Generate a real key with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=django-insecure-CHANGE-ME-IN-PRODUCTION

# Alias for backward compatibility (Django settings reads SECRET_KEY)
SECRET_KEY=${DJANGO_SECRET_KEY}

# Set to False in production. When True, Django shows debug tracebacks.
DEBUG=True

# Comma-separated hostnames allowed to serve the app.
# In production: ALLOWED_HOSTS=trustgraph.example.com,api.trustgraph.example.com
ALLOWED_HOSTS=*

# ─── Database (PostgreSQL) ────────────────────────────────────────────────────
# Use DATABASE_URL for production (Render, Railway, Fly.io, etc.)
# Format: postgresql://USER:PASSWORD@HOST:PORT/NAME
# When unset, the backend falls back to SQLite for local dev.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/trustgraph_db

# Individual DB settings (used when DATABASE_URL is not set)
DB_NAME=trustgraph_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# ─── JWT Authentication ──────────────────────────────────────────────────────

JWT_ACCESS_LIFETIME_MINUTES=30
JWT_REFRESH_LIFETIME_DAYS=1

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Additional origins beyond the default http://localhost:5173.
# Comma-separated. The default Vite dev server origin is always allowed.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ─── AI / ML Engine ──────────────────────────────────────────────────────────

# Set to True to use the real Isolation Forest + NetworkX engine.
# When False, the backend uses the deterministic mock scorer for demos.
AI_ENGINE_ENABLED=True

# Risk score threshold for creating fraud cases and triggering blockchain anchoring.
RISK_THRESHOLD=75

# ─── Blockchain / Web3 ───────────────────────────────────────────────────────

# JSON-RPC endpoint for your target network (alias WEB3_RPC_URL for clarity).
# Polygon Amoy Testnet (Chain ID: 80002):
#   https://rpc-amoy.polygon.technology
# OR use Alchemy/Infura for production-grade reliability:
#   https://polygon-amoy.g.alchemy.com/v2/<YOUR_ALCHEMY_KEY>
WEB3_RPC_URL=https://rpc-amoy.polygon.technology
RPC_URL=${WEB3_RPC_URL}

# The chain ID corresponding to RPC_URL above.
# Polygon Amoy = 80002  |  Ethereum Sepolia = 11155111
CHAIN_ID=80002

# EVM wallet private key used to sign anchorProof() transactions.
# NEVER expose this — use a dedicated service wallet with minimal MATIC balance.
# Fund on Amoy faucet: https://faucet.polygon.technology
WALLET_PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# Deployed TrustGraphAudit.sol contract address (post-deployment).
# Run: npx hardhat run contracts/deploy_audit.js --network polygonAmoy
# Paste the deployed address here (checksum format).
CONTRACT_ADDRESS=0xYOUR_CONTRACT_ADDRESS_HERE

# Block explorer base URL for transaction links (shown in demo output).
# Polygon Amoy:
POLYGONSCAN_BASE=https://amoy.polygonscan.com/tx
# Ethereum Sepolia:
# POLYGONSCAN_BASE=https://sepolia.etherscan.io/tx

# PolygonScan API key for contract verification (optional).
POLYGONSCAN_API_KEY=

# ─── Google Gemini (optional) ─────────────────────────────────────────────────

# Google Gemini API key — used by the AI explanation engine.
# Obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# ─── Frontend (Vite) ─────────────────────────────────────────────────────────
# These variables must be prefixed with VITE_ to be exposed to the browser.

VITE_API_BASE_URL=http://localhost:8000/api/v1
