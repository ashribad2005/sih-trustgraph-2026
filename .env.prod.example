# =============================================================================
# TrustGraph 2026 — Production Environment Configuration Template
# =============================================================================
# Copy this file to .env.prod (NEVER commit .env.prod to version control).
#   cp .env.prod.example .env.prod
#   # Edit .env.prod with your production secrets
#
# ZERO PII POLICY: This config never touches customer data fields.
# All secrets are loaded at runtime.
# =============================================================================

# ─── Django Core ──────────────────────────────────────────────────────────────
# Generate a real key with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# Inject this value through the Render environment, never through source control.
SECRET_KEY=

# MUST be False in production!
DEBUG=False
SECURE_SSL_REDIRECT=True

# Comma-separated hostnames allowed to serve the app.
# In production: ALLOWED_HOSTS=trustgraph.example.com,api.trustgraph.example.com
ALLOWED_HOSTS=trustgraph-api.onrender.com

# ─── Database (PostgreSQL) ────────────────────────────────────────────────────
# Use DATABASE_URL for production (Render, Railway, Fly.io, AWS RDS, etc.)
# Format: postgresql://USER:PASSWORD@HOST:PORT/NAME
# When set, this takes precedence over individual DB_* settings.
DATABASE_URL=postgresql://user:password@host:5432/trustgraph_db

# Optional local Compose inputs; production must provide DATABASE_URL.
DB_NAME=trustgraph_db
DB_USER=postgres
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_HOST=db
DB_PORT=5432

# ─── JWT Authentication ──────────────────────────────────────────────────────
JWT_ACCESS_LIFETIME_MINUTES=30
JWT_REFRESH_LIFETIME_DAYS=1

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated origins. MUST match your frontend domain exactly.
CORS_ALLOWED_ORIGINS=https://your-frontend-domain.com

# ─── AI / ML Engine ──────────────────────────────────────────────────────────
# Set to True to use the real Isolation Forest + NetworkX engine.
# When False, the backend uses the deterministic mock scorer for demos.
AI_ENGINE_ENABLED=True
# Set True only for a judge/demo deployment; the Dockerfile runs seed_data --process once per start.
SEED_DEMO_DATA=False

# Risk score threshold for creating fraud cases and triggering blockchain anchoring.
RISK_THRESHOLD=75

# ─── Blockchain / Web3 ───────────────────────────────────────────────────────
# JSON-RPC endpoint for Polygon Amoy Testnet (Chain ID: 80002)
# Use Alchemy/Infura for production-grade reliability:
#   https://polygon-amoy.g.alchemy.com/v2/<YOUR_ALCHEMY_KEY>
# Leave these empty to keep blockchain integration in safe mock mode until
# an operator has configured valid production credentials in Render.
WEB3_RPC_URL=
RPC_URL=

# Chain ID corresponding to RPC_URL above
# Polygon Amoy = 80002  |  Ethereum Sepolia = 11155111
CHAIN_ID=80002

# EVM wallet private key used to sign anchorProof() transactions.
# NEVER expose this — use a dedicated service wallet with minimal MATIC balance.
# Fund on Amoy faucet: https://faucet.polygon.technology
# INJECT THIS SECURELY VIA YOUR PLATFORM'S SECRET MANAGER (AWS Secrets Manager, Render Env Vars, etc.)
WALLET_PRIVATE_KEY=

# Deployed TrustGraphAudit.sol contract address (post-deployment).
# Run: npx hardhat run contracts/deploy_audit.js --network polygonAmoy
# Paste the deployed address here (checksum format).
CONTRACT_ADDRESS=

# Block explorer base URL for transaction links
# Polygon Amoy:
POLYGONSCAN_BASE=https://amoy.polygonscan.com/tx

# PolygonScan API key for contract verification (optional)
POLYGONSCAN_API_KEY=YOUR_POLYGONSCAN_API_KEY

# ─── Google Gemini (Optional) ─────────────────────────────────────────────────
# Google Gemini API key — used by the AI explanation engine.
# Obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# ─── Frontend (Vite) ─────────────────────────────────────────────────────────
# These variables must be prefixed with VITE_ to be exposed to the browser.
# This is baked into the frontend build at compile time.
VITE_API_BASE_URL=https://trustgraph-api.onrender.com/api/v1
